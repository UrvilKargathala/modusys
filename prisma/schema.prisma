// Prisma schema — PostgreSQL (Neon). Connection string read from env only.
// Batch 1: Customer, Architect (+partners), User. Further entities (Quotes,
// Templates, Tasks, etc.) land in later migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Merged from the client-side pipeline Customer + the separate profile
// overrides overlay (that split was a client artifact, not a real data model).
// `stage`/`assignee` stay String to match the exact keys/names the UI already
// uses — no enum translation layer in every route. Soft-delete via deletedAt.
model Customer {
  id             String    @id @default(cuid())
  name           String
  prefix         String    @default("")
  firstName      String    @default("")
  lastName       String    @default("")
  srNo           Int       @default(0)
  customerCode   String    @default("")
  mobile         String    @default("")
  email          String    @default("")
  gst            String    @default("")
  address        String    @default("")
  city           String    @default("")
  state          String    @default("")
  postcode       String    @default("")
  birthdayMonth  String    @default("")
  birthdayDay    String    @default("")
  birthdayYear   String    @default("")
  architectId    String?
  stage          String    @default("upcoming-inquiry")
  finalOfferLakh Float?
  assignee       String    @default("")
  daysInStage    Int       @default(0)
  lastActivity   DateTime  @default(now())
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  messages Message[]
  media    MediaAttachment[]

  @@index([stage])
  @@index([deletedAt])
}

// Customer profile gallery (photos/videos/documents shared outside chat).
// Previously client-only: files were blob: URLs from URL.createObjectURL,
// which the browser invalidates on reload — so uploads "disappeared" for
// anyone who refreshed, and bulk-downloads silently returned fewer files
// than the gallery listed. Real Blob storage now, so the URL stays valid.
model MediaAttachment {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type         String // image | video | document
  name         String
  url          String
  pathname     String // blob key, needed to delete from Blob storage
  sizeBytes    Int
  durationSec  Int? // videos only
  uploadedById String?
  uploadedAt   DateTime @default(now())

  @@index([customerId, uploadedAt])
}

// CRM chat thread for a customer — was previously client-only (localStorage),
// so messages never left the sending user's browser. Real table now, so
// everyone viewing the same customer sees the same thread.
model Message {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  kind     String  @default("chat") // chat | system | voice | image | pdf
  senderId String? // null for system events
  text     String?

  mentionedUserIds String[] @default([])

  audioUrl    String?
  durationSec Int?

  // Legacy single-image fields — pre-gallery messages still read from here.
  // New sends populate imageUrls[]/imageNames[] instead (imageUrls[0] mirrors
  // imageUrl for single-image sends so old clients don't break).
  imageUrl   String?
  imageName  String?
  imageUrls  String[] @default([])
  imageNames String[] @default([])

  pdfUrl  String?
  pdfName String?
  pdfSize Int?

  // When set, this message is a reply to another Message.id. The referenced
  // message may have been deleted — UI treats a dangling ref as "reply to
  // a removed message" rather than erroring.
  replyToMessageId String?
  replyToImageIndex Int?

  // WhatsApp-style per-user star (not a single shared flag — each user
  // stars independently). Small list, no join table needed.
  starredBy String[] @default([])

  // "Delete for me" hides the message for just these users while it stays
  // visible to everyone else; "delete for everyone" is the existing hard
  // DELETE. A message hidden for every participant is left in place rather
  // than hard-deleted, since senderId/other users' state still reference it.
  deletedForUserIds String[] @default([])

  // Set when this message was created via the "Forward" action, referencing
  // the original message it was copied from (which may itself be deleted).
  forwardedFromId String?

  reactions MessageReaction[]

  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([customerId, createdAt])
}

model MessageReadReceipt {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

// One row per (message, user, emoji) — a user can react with several
// different emoji to the same message, WhatsApp-style, but not the same
// emoji twice (toggling removes it).
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// Ephemeral per-(customer, user) chat state — typing indicator + last-seen.
// Polled the same way messages already are (see POLL_MS in
// customer-messages-store.ts) rather than a websocket, so it reuses the
// existing request cadence instead of adding new infra.
model ChatPresence {
  id         String   @id @default(cuid())
  customerId String
  userId     String
  isTyping   Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@unique([customerId, userId])
  @@index([customerId])
}

model Architect {
  id            String             @id @default(cuid())
  prefix        String             @default("")
  firstName     String
  lastName      String
  mobile        String             @default("")
  office        String             @default("")
  company       String             @default("")
  instagram     String             @default("")
  address       String             @default("")
  city          String             @default("")
  state         String             @default("")
  postcode      String             @default("")
  birthdayMonth String             @default("")
  birthdayDay   String             @default("")
  birthdayYear  String             @default("")
  siteEngineers Json               @default("[]")
  createdById   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
  partners      ArchitectPartner[]

  @@index([deletedAt])
}

model ArchitectPartner {
  id          String    @id @default(cuid())
  prefix      String    @default("")
  firstName   String    @default("")
  lastName    String    @default("")
  mobile      String    @default("")
  architectId String
  architect   Architect @relation(fields: [architectId], references: [id], onDelete: Cascade)

  @@index([architectId])
}

// role stored as String matching the app's exact keys
// ("super-admin" | "admin" | "staff" | "no-role") so route code compares
// against them directly with no enum mapping. passwordHash is nullable —
// real auth is a later phase; the app doesn't set passwords yet.
model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String?
  role               String    @default("no-role")
  status             String    @default("active")
  mustChangePassword Boolean   @default(false)
  passwordUpdatedAt  DateTime?
  // Bumped whenever a password changes; embedded in the signed session token
  // and checked against this column on every request, so rotating it
  // invalidates every other cookie already issued for this user.
  sessionVersion     Int       @default(0)
  lastActive         DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Explicit link to the Employee record this login belongs to. Unique
  // so an Employee is tied to at most one User account. Nullable because
  // not every User has an Employee row yet (external contacts, admins who
  // don't check in, etc.). Falls back to email-match when null.
  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])
}

// ---------------------------------------------------------------------------
// Batch 2: Templates + Quotes.
// Nested trees the app treats as whole blobs (unit-type components/hardware,
// cabinet-type components, quote units, template notes/terms) are stored as
// Json columns rather than fully normalized child tables — the app never
// queries inside them (pricing is computed client-side), so this is far less
// code with the same behavior. Tradeoff: not queryable in SQL, and the
// catalog stores persist via id-preserving bulk-upsert (last-write-wins at
// the collection level, fine for admin-edited catalog data).
// `deleted` mirrors the stores' own boolean soft-delete flag exactly.

model MaterialItem {
  id          String   @id
  category    String
  name        String
  description String   @default("")
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([category])
}

// Reference table for the Templates "Calculator" tab. bottomPanels/
// backPanels are each a JSON array of { id, label, widthFormula,
// heightFormula } — one spec can define several cut panels per side (e.g.
// two different Bottom Panel cuts), each a formula (e.g. "W-10", "H-24")
// referencing this spec's own Length/Width/Height via the same
// evaluateFormula() used for Cabinet Type's widthFormula/heightFormula
// (lib/quote-pricing.ts), not fixed numbers — most hardware catalogs define
// panel cuts as an offset from the opening size rather than one number per
// exact size. Kept as a JSON blob (not a child table) since the app never
// queries inside it, same tradeoff as CabinetType.components.
model PanelCalcSpec {
  id           String   @id
  brand        String
  product      String
  length       Int
  height       Int
  description  String   @default("")
  bottomPanels Json     @default("[]")
  backPanels   Json     @default("[]")
  createdAt    DateTime @default(now())

  @@unique([brand, product, length, height])
  @@index([brand, product])
}

model FurniturePriceItem {
  id                String   @id
  thicknessId       String
  rawMaterialTypeId String
  internalColourId  String
  externalColourId  String
  rate              Float
  deleted           Boolean  @default(false)
  createdAt         DateTime @default(now())
}

model HardwarePriceItem {
  id          String   @id
  articleNo   String
  categoryId  String
  brandId     String
  unitId      String
  levelTypeId String   @default("")
  description String   @default("")
  mrp         Float
  discountPct Float    @default(0)
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model CabinetType {
  id          String   @id
  name        String
  shortCode   String
  active      Boolean  @default(true)
  brandId     String   @default("")
  description String   @default("")
  components  Json     @default("[]")
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model UnitType {
  id               String   @id
  name             String
  shortCode        String
  active           Boolean  @default(true)
  brandId          String   @default("")
  description      String   @default("")
  cabinetTypeLinks Json     @default("[]")
  components       Json     @default("[]")
  externalFinishes Json     @default("[]")
  otherPanels      Json     @default("[]")
  hardware         Json     @default("[]")
  deleted          Boolean  @default(false)
  createdAt        DateTime @default(now())
}

// Singleton config row (id "singleton").
model QuoteTemplateSettings {
  id           String   @id @default("singleton")
  layout       Json
  branding     Json
  banking      Json
  signature    Json
  notes        Json     @default("[]")
  terms        Json     @default("[]")
  paymentTerms Json     @default("[]")
  updatedAt    DateTime @updatedAt
}

model Quote {
  id                          String   @id
  quoteNumber                 String
  date                        String   @default("")
  customerId                  String?
  architectId                 String?
  revision                    Int      @default(0)
  propertyTypeId              String   @default("")
  salesExecutiveId            String   @default("")
  designerId                  String   @default("")
  siteEngineerId              String   @default("")
  productTypeId               String   @default("")
  status                      String   @default("draft")
  markupMultiplier            Float    @default(1)
  materialDescriptionId       String   @default("")
  shutterFinishId             String   @default("")
  // Structured breakdown of the shutter finish spec — 4 sub-selects backed
  // by existing MaterialItem categories (thickness / raw-material-description
  // / internal-colour / external-colour). Independent of the scalar
  // shutterFinishId above, which stays as the quick single-select "family"
  // pick used by legacy renderers.
  shutterFinishThicknessId      String   @default("")
  shutterFinishRawMaterialId    String   @default("")
  shutterFinishInternalColourId String   @default("")
  shutterFinishExternalColourId String   @default("")
  handleTypeId                String   @default("")
  hingesTypeId                String   @default("")
  clientResponsibilityId      String   @default("")
  tandemDrawerTypeId          String   @default("")
  units                       Json     @default("[]")
  finishOptions               Json     @default("[]")
  specialDiscountPct          Float    @default(0)
  installationFreightIncluded Boolean  @default(true)
  installationFreightCost     Float    @default(0)
  remark                      String   @default("")
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([status])
}

// Assigned work items — CRM Tasks tab + Dashboard Upcoming Tasks panel both
// read from this. priority and status stay String per app convention (no
// Prisma enums); values are "low"|"normal"|"high"|"urgent" and
// "pending"|"completed". createdById/assigneeId are plain String (not FK
// relations) so a deleted user doesn't cascade-nuke tasks; the app resolves
// the User row live and falls back to "Unknown" when missing.
model Task {
  id               String    @id @default(cuid())
  title            String
  description      String    @default("")
  dueDate          String    @default("") // ISO yyyy-mm-dd string, "" when unset
  priority         String    @default("normal")
  status           String    @default("pending")
  assigneeId       String
  createdById      String
  linkedCustomerId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  completedAt      DateTime?

  @@index([assigneeId])
  @@index([createdById])
  @@index([status])
}

// Real-DB notification feed backing the bell dropdown + dashboard panel.
// One row per recipient — a task assigned by super-admin to a staff user
// writes one row, addressed to that staff user's id. The API scopes reads
// to the auth cookie so nobody sees anyone else's notifications.
model Notification {
  id            String   @id @default(cuid())
  userId        String
  type          String // "assigned" | "completed" (future: "due-soon" | "mentioned")
  relatedTaskId String?
  message       String
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, read, createdAt])
}

// Lightweight trail for account-takeover-capable actions (password changes,
// invites, role changes). Actor/target names are denormalized at write time
// rather than joined live, so the log still reads correctly after a user is
// renamed or deleted.
model SecurityAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String
  actorName    String
  targetUserId String?
  targetName   String?
  action       String // PASSWORD_CHANGED_SELF | PASSWORD_SET_BY_ADMIN | USER_INVITED | ROLE_CHANGED
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// Full audit trail for Phase 1 security-sensitive and destructive actions.
// Denormalized actor/target snapshots so the log stays readable after renames
// or deletions. The details JSON holds field-level before/after for edits.
model AuditLog {
  id           String   @id @default(cuid())
  action       String
  actorUserId  String?
  actorEmail   String   @default("")
  actorName    String   @default("")
  targetType   String?
  targetId     String?
  targetLabel  String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  result       String   @default("SUCCESS")
  createdAt    DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
}

// ---------------------------------------------------------------------------
// Attendance (UniFi Access integration)

model Employee {
  id             String   @id @default(cuid())
  name           String
  email          String?  @unique
  phone          String?
  department     String?
  designation    String?
  employeeNumber String?  @unique
  unifiUserId    String?  @unique
  unifiFullName  String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]
  linkedUser        User?
}

model AttendanceRecord {
  id               String    @id @default(cuid())
  employeeId       String
  date             DateTime  @db.Date
  checkIn          DateTime
  checkOut         DateTime?
  checkOutDoorName String?
  doorName         String?
  doorId           String?
  credentialType   String?
  source           String    @default("manual")
  notes            String?
  // Remote (GPS) check-in/out fields — coexist with UniFi face-scan data on
  // the same row. Face scan takes priority on checkIn: the webhook overwrites
  // checkIn time + flips checkInSource to "unifi" but leaves the GPS lat/lng
  // in place as additional context.
  checkInLat       Float?
  checkInLng       Float?
  checkOutLat      Float?
  checkOutLng      Float?
  checkInAddress   String?
  checkOutAddress  String?
  checkInNote      String?
  checkOutNote     String?
  // source values: "unifi" (face scan) | "gps+photo" (remote check-in) |
  // legacy "gps" / "manual" from earlier migrations still readable.
  checkInSource    String    @default("unifi")
  checkOutSource   String?
  // Derived attendance stats — recomputed on every check-in/check-out write
  // (see /api/attendance/check-in and /check-out) and by the UniFi webhook,
  // then backfilled for old rows by scripts/backfill-attendance-stats.ts.
  // No break deduction: workingMinutes = checkOut − checkIn (wall clock).
  workingMinutes       Int?
  // "IN_PROGRESS" | "HALF_DAY" | "FULL_DAY" — half if <4h30m worked.
  dayStatus            String?
  // Late = checkIn strictly AFTER 10:15 AM IST. Informational only, no
  // salary/leave deduction is tied to this flag.
  isLate               Boolean @default(false)
  lateByMinutes        Int?
  // Early exit = checkOut before 6:30 PM IST.
  isEarlyExit          Boolean @default(false)
  earlyExitByMinutes   Int?
  // (Photo columns still present from earlier migration but no longer used —
  // Photo Attendance now lives in its own PhotoAttendanceRecord table so the
  // two systems don't share state or unique constraints. Safe to drop in a
  // later cleanup migration.)
  checkInPhotoUrl      String?
  checkOutPhotoUrl     String?
  checkInPhotoConsent  Boolean  @default(false)
  checkOutPhotoConsent Boolean  @default(false)
  // IANA timezone the record was captured in — Modusys is India, so this is
  // "Asia/Kolkata" today. Stored per-row so future international expansion
  // renders each row in the correct local time.
  timezone         String    @default("Asia/Kolkata")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId])
}

model LeaveRequest {
  id            String    @id @default(cuid())
  employeeId    String
  leaveType     String
  // Free-text label shown in the UI when leaveType is "OTHER". Null for the
  // built-in categories.
  customLeaveType String?
  fromDate      DateTime  @db.Date
  toDate        DateTime  @db.Date
  totalDays     Float
  isHalfDay     Boolean   @default(false)
  halfDayType   String?
  reason        String
  status        String    @default("PENDING")
  appliedAt     DateTime  @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?
  reviewNote    String?
  attachmentUrl String?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([fromDate, toDate])
}

model UnifiSyncLog {
  id               String   @id @default(cuid())
  syncType         String
  status           String
  details          String?
  recordsProcessed Int      @default(0)
  createdAt        DateTime @default(now())
}

// Super-admin-added pipeline stages. Baseline stages live in
// lib/constants/pipelineStages.ts; rows in this table extend that list
// with custom stages that appear as new Kanban columns and become
// selectable in the customer stage picker. Baseline stages are NOT
// mirrored here — the effective list is baseline + custom, ordered by
// sortOrder within each half.
model CustomPipelineStage {
  key       String   @id
  label     String
  color     String   // key from stageColorTokens (grey, info, purple, primary, cyan, teal, orange, indigo, secondary, pink, warning, success, error)
  sortOrder Int
  retired   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// UniFi face-scan / RFID door-tap audit log. Face scans are NO LONGER a
// source of attendance — GPS+selfie via the app is the single source of
// truth. These rows exist only as a security audit trail so an admin can
// still answer "who came through the door at 10:14 AM?" without inferring
// from the app's attendance table.
//
// Written by /api/webhooks/unifi-access on every access.door.unlock event.
// Never joined against AttendanceRecord — reports/my-attendance ignore it.
model DoorAccessLog {
  id             String   @id @default(cuid())
  // Nullable because the webhook can receive events for actors we haven't
  // mapped to an Employee yet — still worth keeping for security review.
  employeeId     String?
  unifiUserId    String
  unifiUserName  String?
  doorName       String?
  doorId         String?
  credentialType String?
  timestamp      DateTime
  createdAt      DateTime @default(now())

  @@index([employeeId, timestamp])
  @@index([timestamp])
}

// Photo Attendance — independent from AttendanceRecord (which handles
// UniFi face scan + remote GPS). Same "one row per employee per IST day"
// key, but its own table so both systems can coexist for the same day
// without stepping on the shared @@unique constraint.
model PhotoAttendanceRecord {
  id                   String    @id @default(cuid())
  employeeId           String
  date                 DateTime  @db.Date
  checkIn              DateTime
  checkOut             DateTime?
  checkInPhotoUrl      String
  checkOutPhotoUrl     String?
  checkInPhotoConsent  Boolean   @default(true)
  checkOutPhotoConsent Boolean   @default(false)
  checkInNote          String?
  checkOutNote         String?
  timezone             String    @default("Asia/Kolkata")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId])
}
