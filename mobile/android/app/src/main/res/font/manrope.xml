<?xml version="1.0" encoding="utf-8"?>
<!-- Manrope weights for fontWeight on Android (registered in MainApplication.kt; iOS picks them by family name). -->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto">
    <font app:fontStyle="normal" app:fontWeight="300" app:font="@font/manrope_light" />
    <font app:fontStyle="normal" app:fontWeight="400" app:font="@font/manrope_regular" />
    <font app:fontStyle="normal" app:fontWeight="500" app:font="@font/manrope_medium" />
    <font app:fontStyle="normal" app:fontWeight="600" app:font="@font/manrope_semibold" />
    <font app:fontStyle="normal" app:fontWeight="700" app:font="@font/manrope_bold" />
</font-family>
